# =============================================================================
# Azkintun-RSS — variables de entorno para docker compose
# Copiá este archivo a .env y ajustá los valores.  (¡NO commitees .env!)
# =============================================================================

# ── Autenticación ──────────────────────────────────────────────────────────

# Secreto para firmar los JWT (HMAC-SHA256). DEBE tener >= 32 caracteres.
# Generá uno propio con:  openssl rand -hex 32
JWT_SECRET=d2074b6cc8ca8c363b0149f817f9b04debf5cf1295ff620e48ddfe4c242dd64f

# Usuario admin inicial (se crea solo la primera vez, si no hay usuarios).
ADMIN_USERNAME=admin

# Contraseña del admin inicial. Si la dejás vacía, el backend genera una
# aleatoria y la imprime UNA vez en los logs (docker compose logs backend).
ADMIN_PASSWORD=-1TFoc3PaWoV-MIagcLIJQ

# Vida útil de cada token de sesión, en horas.
JWT_TTL_HOURS=24

# Flag Secure de la cookie de sesión.
#   false → acceso por http://localhost (desarrollo).
#   true  → SOLO si servís el frontend detrás de HTTPS/TLS (producción).
COOKIE_SECURE=false

# ── App ─────────────────────────────────────────────────────────────────────

# Puerto del frontend (nginx) publicado en el host.
FRONTEND_PORT=8080

# Cada cuántos minutos se re-scrapean todas las fuentes activas.
SCRAPE_INTERVAL_MINUTES=15

# Cuántas fuentes se scrapean en paralelo (con ~1400 feeds, subilo si
# tu red/CPU lo permiten; bajalo si querés ser más gentil con los sitios).
SCRAPE_CONCURRENCY=16

# Nivel de logging del backend.
RUST_LOG=info
